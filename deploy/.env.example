# 复制成 .env 后填写：cp .env.example .env
# 后端域名，DNS 的 A 记录要先指向这台服务器。同一个域名也用作邀请链接，App 打包时 API_BASE_URL 和 INVITE_HOST 填它
DOMAIN=api.example.com

# 用 openssl rand -hex 32 生成，四个都要不同
POSTGRES_PASSWORD=
JWT_SECRET=
PHONE_PEPPER=
PHONE_KEY_HEX=

DEFAULT_TIME_ZONE=Asia/Shanghai

# 登录验证码短信。还没申请下阿里云短信时先留 console，验证码会打在 docker compose logs backend 里
SMS_PROVIDER=console
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# APNs：开发者后台 Keys 里建的 .p8，内容的换行写成 \n，整段用双引号包起来
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
IOS_BUNDLE_ID=app.nightescort.ios
WATCH_BUNDLE_ID=app.nightescort.ios.watchkitapp
# 开发者账号的团队 ID（和 APNS_TEAM_ID 相同），通用链接要用
APPLE_TEAM_ID=
APPLE_AUDIENCES=app.nightescort.ios

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# TestFlight 外部测试的公开链接，邀请落地页用
TESTFLIGHT_URL=
APP_STORE_URL=
