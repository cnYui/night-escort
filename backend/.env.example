# 复制成 .env 后按需修改。开发环境不填也能跑（验证码打印在日志里，推送只记录不发送）。
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5432/night_escort
REDIS_URL=redis://127.0.0.1:6379
PUBLIC_BASE_URL=https://ye.example.com

# 生产必填：用 openssl rand -hex 32 生成
JWT_SECRET=
PHONE_PEPPER=
PHONE_KEY_HEX=

# 短信（只用于登录验证码，报警不发短信）
SMS_PROVIDER=console
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# APNs（Apple 开发者后台 Keys 里建一个 APNs key，.p8 内容换行写成 \n）
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
IOS_BUNDLE_ID=app.nightescort.ios
WATCH_BUNDLE_ID=app.nightescort.ios.watchkitapp
APPLE_TEAM_ID=
APPLE_AUDIENCES=app.nightescort.ios

# 微信开放平台移动应用
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 上架前填 TestFlight 公开链接；上架后填 App Store 链接，落地页会自动切换
TESTFLIGHT_URL=
APP_STORE_URL=
